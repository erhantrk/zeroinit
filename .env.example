# Copy to .env, fill in, then: set -a; source .env; set +a
# Optional values are commented out: a set-but-empty ZI_CODE_HASH would be rejected when sourced.
ZI_NETWORK=testnet
ZI_RPC_URL=https://test.rpc.fastnear.com
ZI_SCHEME=0u
# v3 (v-next, NOT DEPLOYED YET): the hash of the wasm built from this repo. Deploy it first, then pay/issue on it.
# v2, 4bQ61AgH…yx9zEA, and v1, Amg4WXKy…GW6k, are history: `zi verify` / `zi replay` still check them, but never set
# a historical hash here (pay/sweep/init refuse a historical invoice).
ZI_CODE_HASH=ATRjmY1xny8mznwsqYjMUgJLYFEgiKqg3mRM7NfS3Dp3
# The tUSDC (mock NEP-141, 6 decimals) account id, a public id (not a secret). Required for `--token tUSDC`;
# leave it empty and the client refuses token invoices with a clear message.
ZI_TUSDC_ACCOUNT=
# The v3 testnet accounts (docs/STABLECOIN.md §2), for reference. The operator creates them; the client only needs the two keys below.
#   sm1110-zi3-deployer.testnet   sm1110-zi3-merchant.testnet   sm1110-zi3-taxvault.testnet
#   sm1110-zi3-payer.testnet      sm1110-zi3-sweeper.testnet    sm1110-zi3-unreg.testnet
#   late.sm1110-zi3-merchant.testnet (created later, for the "merchant does not exist yet" case)
# Fill these in (accounts and keys) to sign; leave commented out for offline use:
# ZI_PAYER_ACCOUNT=
# ZI_PAYER_KEY=
# ZI_SWEEPER_ACCOUNT=
# ZI_SWEEPER_KEY=
# ZI_TAXVAULT_ACCOUNT=
ZI_INVOICE_DIR=invoices
# Optional: record RPC calls to this file (fixtures)
# ZI_RECORD=
