# Copy to .env, fill in, then: set -a; source .env; set +a
# Optional values are commented out: a set-but-empty ZI_CODE_HASH would be rejected when sourced.
ZI_NETWORK=testnet
ZI_RPC_URL=https://rpc.testnet.near.org
ZI_SCHEME=0u
# The frozen global contract deployed on testnet (public code hash, not a secret):
ZI_CODE_HASH=Amg4WXKyZe2RAyjUjtX2cgU4RW5615abgccyKtiUGW6k
# Fill these in (accounts and keys) to sign; leave commented out for offline use:
# ZI_PAYER_ACCOUNT=
# ZI_PAYER_KEY=
# ZI_SWEEPER_ACCOUNT=
# ZI_SWEEPER_KEY=
# ZI_TAXVAULT_ACCOUNT=
ZI_INVOICE_DIR=invoices
# Optional: record RPC calls to this file (fixtures)
# ZI_RECORD=
