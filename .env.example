# Copy to .env, fill in, then: set -a; source .env; set +a
# Optional values are commented out: a set-but-empty ZI_CODE_HASH would be rejected when sourced.
ZI_NETWORK=testnet
ZI_RPC_URL=https://rpc.testnet.fastnear.com
ZI_SCHEME=0u
# v3 (current, deployed on testnet): the hash of the wasm built from this repo (the client default; setting it is optional).
# v2, 4bQ61AgH…yx9zEA, and v1, Amg4WXKy…GW6k, are history: `zi verify` / `zi replay` still check them, but never set
# a historical hash here (pay/sweep/init refuse a historical invoice).
ZI_CODE_HASH=Ut7EQhLDrvYVarHb6ZaXk6m7o9kQqYPCpyqiamvreWa
# The tUSDC (mock NEP-141, 6 decimals) account id, a public id (not a secret). The client default is the deployed testnet mock
# sm1110-tusdc.testnet; set another id to use your own instance, or set it EMPTY to switch token invoices off.
# ZI_TUSDC_ACCOUNT=sm1110-tusdc.testnet
# The v3 testnet accounts (docs/STABLECOIN.md §2), for reference. The operator created them; the client only needs the keys below.
#   sm1110-zi3-deployer.testnet   sm1110-zi3-merchant.testnet   sm1110-zi3-taxvault.testnet
#   sm1110-zi3-payer.testnet      sm1110-zi3-sweeper.testnet    sm1110-zi3-unreg.testnet
#   late.sm1110-zi3-merchant.testnet (never created in the recorded run: the "merchant does not exist yet" case)
#   never.sm1110-zi3-merchant.testnet (never created: the refund_payer case)
#   sm1110-zi3-unreg2.testnet (exists, never registered on tUSDC: the token refund_payer case)
# The record-v3-*.sh scripts use the sweeper account as the merchant, so register the sweeper on tUSDC too, and read
# ZI_UNREG_ACCOUNT, ZI_UNREG2_ACCOUNT and ZI_FAKE_TOKEN_ACCOUNT from .env:
# ZI_UNREG_ACCOUNT=sm1110-zi3-unreg.testnet
# ZI_UNREG2_ACCOUNT=sm1110-zi3-unreg2.testnet
# ZI_FAKE_TOKEN_ACCOUNT=sm1110-zi3-fake.testnet
# Fill these in (accounts and keys) to sign; leave commented out for offline use:
# ZI_PAYER_ACCOUNT=
# ZI_PAYER_KEY=
# ZI_SWEEPER_ACCOUNT=
# ZI_SWEEPER_KEY=
# ZI_TAXVAULT_ACCOUNT=
ZI_INVOICE_DIR=invoices
# Optional: record RPC calls to this file (fixtures)
# ZI_RECORD=
