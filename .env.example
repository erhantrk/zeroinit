# Copy to .env, fill in, then: set -a; source .env; set +a
# Optional values are commented out: a set-but-empty ZI_CODE_HASH would be rejected when sourced.
ZI_NETWORK=testnet
ZI_RPC_URL=https://test.rpc.fastnear.com
ZI_SCHEME=0u
# The current global contract (v2) deployed on testnet (public code hash, not a secret). v1, Amg4WXKy…GW6k, is history:
# `zi verify` / `zi replay` still check it, but never set it here.
ZI_CODE_HASH=4bQ61AgHWWmYXp5c3fwj9NJxS79D9R3cGZAZxHyx9zEA
# Fill these in (accounts and keys) to sign; leave commented out for offline use:
# ZI_PAYER_ACCOUNT=
# ZI_PAYER_KEY=
# ZI_SWEEPER_ACCOUNT=
# ZI_SWEEPER_KEY=
# ZI_TAXVAULT_ACCOUNT=
ZI_INVOICE_DIR=invoices
# Optional: record RPC calls to this file (fixtures)
# ZI_RECORD=
